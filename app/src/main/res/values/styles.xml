<resources>
    <!-- Android 15+: as barras do sistema ficam transparentes sobre o fundo claro do app,
         então os ícones delas precisam ser escuros. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#7656D6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F7F6FA</item>
    </style>
</resources>
